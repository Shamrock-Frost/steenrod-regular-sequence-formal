import Height.Geometry.RegularOfHeight
import Mathlib.RingTheory.GradedAlgebra.Radical
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Ideal.MinimalPrime.Localization
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# The regular-sequence criterion for homogeneous generators

The criterion `Height.Geometry.isRegular_of_height_take` asks for the
height of *every prefix* of the list.  This file supplies those prefix heights
for a list of homogeneous polynomials of positive degree, so that the exact
height of the full ideal alone suffices, which is what `rem:krull` of
the paper uses.

The mechanism is the classical one.  Write `R = MvPolynomial σ K` and let
`m₀ = ker constantCoeff` be the irrelevant maximal ideal.

* `isHomogeneous_of_mem_minimalPrimes`: a minimal prime `P` over a homogeneous
  ideal is homogeneous.  Indeed `P.homogeneousCore` is prime
  (`Ideal.IsPrime.homogeneousCore`) and still contains `I`, so minimality forces
  `P = P.homogeneousCore`.
* `le_irrelevantIdeal_of_isHomogeneous`: a *proper* homogeneous ideal of `R`
  lies in `m₀`, because its degree-`0` component consists of constants, and a
  nonzero constant is a unit.
* `height_map_atPrime_of_isHomogeneous`: consequently every minimal prime of a
  proper homogeneous `I` survives in `R_{m₀}` with its height, so
  `ht (I R_{m₀}) = ht I`.  (The inequality `ht I ≤ ht (I R_{m₀})` holds for any
  ideal, by `IsLocalization.height_under`.)
* `isRegular_of_height_eq_length_of_isHomogeneous`: `R_{m₀}` is Cohen–Macaulay
  local, so `isRegular_of_ofList_height_eq_length_of_isCohenMacaulayLocalRing`
  turns the height hypothesis into a regular sequence there; its prefixes are
  weakly regular, so `Ideal.ofList_height_eq_length_of_isWeaklyRegular'` gives
  the prefix heights in `R_{m₀}`, which descend to `R` by the previous item.
  `isRegular_of_height_take` then concludes in `R` itself.
-/

universe u v

open RingTheory.Sequence MvPolynomial

namespace Height.Geometry

/-! ### Minimal primes of a homogeneous ideal are homogeneous -/

section Graded

variable {ι σA A : Type*} [CommRing A]
variable [AddCommMonoid ι] [LinearOrder ι] [IsOrderedCancelAddMonoid ι]
variable [SetLike σA A] [AddSubmonoidClass σA A] {𝒜 : ι → σA} [GradedRing 𝒜]

/-- A minimal prime over a homogeneous ideal is homogeneous: the homogeneous
core of such a prime is again prime and still contains the ideal, so
minimality identifies the prime with its core. -/
theorem isHomogeneous_of_mem_minimalPrimes {I P : Ideal A} (hI : I.IsHomogeneous 𝒜)
    (hP : P ∈ I.minimalPrimes) : P.IsHomogeneous 𝒜 := by
  have hPp : P.IsPrime := hP.isPrime
  have hcore : ((P.homogeneousCore 𝒜).toIdeal).IsPrime := hPp.homogeneousCore
  have hIcore : I ≤ (P.homogeneousCore 𝒜).toIdeal := by
    conv_lhs => rw [← hI.toIdeal_homogeneousCore_eq_self]
    exact Ideal.homogeneousCore_mono 𝒜 hP.le
  have hle : (P.homogeneousCore 𝒜).toIdeal ≤ P := Ideal.toIdeal_homogeneousCore_le 𝒜 P
  have hge : P ≤ (P.homogeneousCore 𝒜).toIdeal := hP.2 ⟨hcore, hIcore⟩ hle
  have hEq : P = (P.homogeneousCore 𝒜).toIdeal := le_antisymm hge hle
  rw [hEq]
  exact HomogeneousIdeal.isHomogeneous _

end Graded

/-! ### The irrelevant maximal ideal of a polynomial ring -/

section Irrelevant

variable (K : Type u) [Field K] (σ : Type v)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The irrelevant maximal ideal of `MvPolynomial σ K`: the kernel of
`constantCoeff`, i.e. the ideal generated by the variables. -/
noncomputable def irrelevantIdeal : Ideal (MvPolynomial σ K) :=
  RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ K →+* K)

theorem isMaximal_irrelevantIdeal : (irrelevantIdeal K σ).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun c => ⟨MvPolynomial.C c, by simp⟩

instance isPrime_irrelevantIdeal : (irrelevantIdeal K σ).IsPrime :=
  (isMaximal_irrelevantIdeal K σ).isPrime

variable {K σ}

theorem mem_irrelevantIdeal_iff {f : MvPolynomial σ K} :
    f ∈ irrelevantIdeal K σ ↔ MvPolynomial.constantCoeff f = 0 :=
  Iff.rfl

/-- A homogeneous polynomial of positive degree has no constant term. -/
theorem mem_irrelevantIdeal_of_isHomogeneous {f : MvPolynomial σ K} {d : ℕ} (hd : 0 < d)
    (hf : f.IsHomogeneous d) : f ∈ irrelevantIdeal K σ := by
  rw [mem_irrelevantIdeal_iff, MvPolynomial.constantCoeff_eq]
  refine hf.coeff_eq_zero ?_
  simpa using hd.ne

/-- A proper homogeneous ideal of a polynomial ring over a field lies in the
irrelevant maximal ideal: its degree-`0` component is a constant, and a nonzero
constant is a unit. -/
theorem le_irrelevantIdeal_of_isHomogeneous {I : Ideal (MvPolynomial σ K)}
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ K)) (hne : I ≠ ⊤) :
    I ≤ irrelevantIdeal K σ := by
  intro f hf
  rw [mem_irrelevantIdeal_iff, MvPolynomial.constantCoeff_eq]
  by_contra hc
  refine hne (Ideal.eq_top_of_isUnit_mem I
    (MvPolynomial.homogeneousComponent_mem_of_mem hI hf 0) ?_)
  rw [MvPolynomial.homogeneousComponent_zero]
  exact isUnit_iff_exists_inv.mpr
    ⟨MvPolynomial.C (f.coeff 0)⁻¹, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩

end Irrelevant

/-! ### Heights of homogeneous ideals are computed at the irrelevant ideal -/

section Localized

variable {K : Type u} [Field K] {σ : Type v}

attribute [local instance] MvPolynomial.gradedAlgebra

/-- For a homogeneous ideal of `MvPolynomial σ K`, extension to the
localization at the irrelevant maximal ideal preserves the height: every
minimal prime is homogeneous, hence contained in the irrelevant ideal, hence
survives with its height. -/
theorem height_map_atPrime_of_isHomogeneous {I : Ideal (MvPolynomial σ K)}
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ K)) :
    (I.map (algebraMap (MvPolynomial σ K)
        (Localization.AtPrime (irrelevantIdeal K σ)))).height = I.height := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.height_eq_inf_minimalPrimes (I := I)]
    refine le_iInf₂ fun P hP => ?_
    have : P.IsPrime := hP.isPrime
    have hPm : P ≤ irrelevantIdeal K σ :=
      le_irrelevantIdeal_of_isHomogeneous (isHomogeneous_of_mem_minimalPrimes hI hP)
        hP.isPrime.ne_top
    have hdisj : Disjoint ((irrelevantIdeal K σ).primeCompl : Set (MvPolynomial σ K))
        (P : Set (MvPolynomial σ K)) :=
      Set.disjoint_left.mpr fun a ha hb => ha (hPm hb)
    calc (I.map (algebraMap (MvPolynomial σ K)
            (Localization.AtPrime (irrelevantIdeal K σ)))).height
        ≤ (P.map (algebraMap (MvPolynomial σ K)
            (Localization.AtPrime (irrelevantIdeal K σ)))).height :=
          Ideal.height_mono (Ideal.map_mono hP.le)
      _ = P.height := IsLocalization.height_map_of_disjoint _ P hdisj
  · calc I.height
        ≤ ((I.map (algebraMap (MvPolynomial σ K)
            (Localization.AtPrime (irrelevantIdeal K σ)))).under (MvPolynomial σ K)).height :=
          Ideal.height_mono Ideal.le_comap_map
      _ = (I.map (algebraMap (MvPolynomial σ K)
            (Localization.AtPrime (irrelevantIdeal K σ)))).height :=
          IsLocalization.height_under (irrelevantIdeal K σ).primeCompl _

end Localized

/-! ### Prefixes of a weakly regular sequence -/

/-- A prefix of a weakly regular sequence is weakly regular. -/
theorem isWeaklyRegular_take {R : Type*} [CommRing R] {rs : List R}
    (h : IsWeaklyRegular R rs) (i : ℕ) : IsWeaklyRegular R (rs.take i) := by
  refine (isWeaklyRegular_iff R (rs.take i)).mpr fun j hj => ?_
  rw [List.length_take] at hj
  have hji : j < i := lt_of_lt_of_le hj (min_le_left _ _)
  have hjr : j < rs.length := lt_of_lt_of_le hj (min_le_right _ _)
  have hprefix : (rs.take i).take j = rs.take j := by
    rw [List.take_take]
    congr 1
    omega
  rw [List.getElem_take, hprefix]
  exact h.regular_mod_prev j hjr

/-! ### The criterion for homogeneous generators of positive degree -/

section Main

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **The criterion, homogeneous form.**  A list of homogeneous polynomials of positive
degree whose span has height equal to the length of the list is a regular
sequence.

Unlike `Height.Geometry.isRegular_of_height_take`, only the height of the whole
ideal is assumed; the prefix heights are *derived*, by localising at the
irrelevant maximal ideal `m₀`, where the Cohen–Macaulay criterion applies
because every prefix ideal is again homogeneous and therefore has all of its
minimal primes inside `m₀`.  The hypothesis of positive degree is what rules
out the obstruction to the unprefixed form: in the standard witness
`[x*y, x*z, x - 1]` of `K[x, y, z]`, whose span is the maximal ideal of
`(1, 0, 0)`, the element `x - 1` is inhomogeneous. -/
theorem isRegular_of_height_eq_length_of_isHomogeneous
    {K : Type u} [Field K] {σ : Type v} [Finite σ] (rs : List (MvPolynomial σ K))
    (hhom : ∀ f ∈ rs, ∃ d : ℕ, 0 < d ∧ f.IsHomogeneous d)
    (h : (Ideal.ofList rs).height = (rs.length : ℕ∞)) :
    IsRegular (MvPolynomial σ K) rs := by
  classical
  have hCM : IsCohenMacaulayRing (MvPolynomial σ K) := isCohenMacaulayRing_mvPolynomial K σ
  have hCML : IsCohenMacaulayLocalRing (Localization.AtPrime (irrelevantIdeal K σ)) :=
    (isCohenMacaulayRing_def (MvPolynomial σ K)).mp hCM _ (isPrime_irrelevantIdeal K σ)
  have hNoethA : IsNoetherianRing (Localization.AtPrime (irrelevantIdeal K σ)) :=
    IsLocalization.isNoetherianRing (irrelevantIdeal K σ).primeCompl _ inferInstance
  -- every prefix ideal is homogeneous
  have hpref : ∀ i, (Ideal.ofList (rs.take i)).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule σ K) := by
    intro i
    refine Ideal.homogeneous_span _ _ fun x hx => ?_
    obtain ⟨d, _, hxd⟩ := hhom x (List.mem_of_mem_take hx)
    exact ⟨d, (MvPolynomial.mem_homogeneousSubmodule d x).mpr hxd⟩
  have hall : (Ideal.ofList rs).IsHomogeneous (MvPolynomial.homogeneousSubmodule σ K) := by
    simpa using hpref rs.length
  -- every prefix lies in the irrelevant maximal ideal
  have hmem : ∀ i, ∀ x ∈ rs.take i, algebraMap (MvPolynomial σ K)
      (Localization.AtPrime (irrelevantIdeal K σ)) x ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime (irrelevantIdeal K σ)) := by
    intro i x hx
    obtain ⟨d, hd, hxd⟩ := hhom x (List.mem_of_mem_take hx)
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (irrelevantIdeal K σ) x).mpr
      (mem_irrelevantIdeal_of_isHomogeneous hd hxd)
  have hmem' : ∀ i, ∀ x ∈ (rs.take i).map (algebraMap (MvPolynomial σ K)
      (Localization.AtPrime (irrelevantIdeal K σ))),
      x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (irrelevantIdeal K σ)) := by
    intro i x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact hmem i y hy
  -- the whole list is a regular sequence in the localization
  have hfull : (Ideal.ofList (rs.map (algebraMap (MvPolynomial σ K)
      (Localization.AtPrime (irrelevantIdeal K σ))))).height
      = ((rs.map (algebraMap (MvPolynomial σ K)
          (Localization.AtPrime (irrelevantIdeal K σ)))).length : ℕ∞) := by
    rw [← Ideal.map_ofList, height_map_atPrime_of_isHomogeneous hall, h, List.length_map]
  have hregA : IsRegular (Localization.AtPrime (irrelevantIdeal K σ))
      (rs.map (algebraMap (MvPolynomial σ K)
        (Localization.AtPrime (irrelevantIdeal K σ)))) :=
    isRegular_of_ofList_height_eq_length_of_isCohenMacaulayLocalRing _
      (by simpa using hmem' rs.length) hfull
  -- hence every prefix has the expected height, first in the localization, then downstairs
  refine isRegular_of_height_take rs fun i hi => ?_
  have hwr : IsWeaklyRegular (Localization.AtPrime (irrelevantIdeal K σ))
      ((rs.take i).map (algebraMap (MvPolynomial σ K)
        (Localization.AtPrime (irrelevantIdeal K σ)))) := by
    rw [List.map_take]
    exact isWeaklyRegular_take hregA.toIsWeaklyRegular i
  have hloc := Ideal.ofList_height_eq_length_of_isWeaklyRegular' _ hwr (hmem' i)
  rw [← Ideal.map_ofList, height_map_atPrime_of_isHomogeneous (hpref i), List.length_map,
    List.length_take, min_eq_left hi] at hloc
  exact hloc

end Main

end Height.Geometry
