import Height.Steenrod.Criterion
import Height.Steenrod.Homogeneity
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Mathlib.Algebra.BigOperators.Intervals

/-!
# The Steenrod ideal (`defn:J`)

This packages the fixed generator list as an ideal, proves that constant
conjugation fixes the ideal, and identifies its pointwise zero locus with the
list-based predicate used by the pencil criterion.

The first section counts the generators: the strict triangle
`0 ≤ i < j ≤ n` has `C(n+1,2)` entries, the number appearing in `rem:krull`
and in `thm:main`.
-/

namespace Height.Steenrod

section GeneratorCount

/-! ### The number of triangular Steenrod generators -/

/-- The strict lower triangle `0 ≤ i < j ≤ N` has `binom(N+1,2)`
entries. -/
theorem length_strictLowerTriangleIndices (N : ℕ) :
    (QSteenrod.strictLowerTriangleIndices N).length = (N + 1).choose 2 := by
  rw [QSteenrod.strictLowerTriangleIndices, List.length_flatMap]
  simp only [List.length_map, List.length_range]
  change (List.map id (List.range' 1 N)).sum = (N + 1).choose 2
  rw [List.map_id]
  rw [List.sum_range', Nat.choose_two_right, Nat.triangle_succ]
  simp [Nat.add_comm]

/-- Consequently the list `powerCharacteristicCoefficients`
contains exactly `binom(N+1,2)` generators. -/
theorem length_powerCharacteristicCoefficients (p r N : ℕ)
    [Fact p.Prime] :
    (QSteenrod.powerCharacteristicCoefficients p r N).length =
      (N + 1).choose 2 := by
  rw [QSteenrod.powerCharacteristicCoefficients, List.length_map,
    length_strictLowerTriangleIndices]

end GeneratorCount

attribute [local instance] MvPolynomial.gradedAlgebra

variable (p r N : ℕ) [Fact p.Prime]

/-- The ideal generated by the strict-triangle family `P^i(c_j)`. -/
noncomputable def steenrodIdeal :
    Ideal (QSteenrod.GenericMatrixRing p r N) :=
  Ideal.span {f : QSteenrod.GenericMatrixRing p r N |
    f ∈ QSteenrod.powerCharacteristicCoefficients p r N}

theorem mem_steenrodIdeal_of_mem_generators
    {f : QSteenrod.GenericMatrixRing p r N}
    (hf : f ∈ QSteenrod.powerCharacteristicCoefficients p r N) :
    f ∈ steenrodIdeal p r N :=
  Ideal.subset_span hf

/-- Every listed generator is homogeneous, with the degree dictated by its
unique strict-triangle index. -/
theorem generator_isHomogeneous [NeZero r]
    {f : QSteenrod.GenericMatrixRing p r N}
    (hf : f ∈ QSteenrod.powerCharacteristicCoefficients p r N) :
    ∃ i j, 1 ≤ j ∧ j ≤ N ∧ i < j ∧
      f = QSteenrod.P p r i (QSteenrod.c p r N j) ∧
      f.IsHomogeneous (j + i * (QSteenrod.q p r - 1)) := by
  simp only [QSteenrod.powerCharacteristicCoefficients, List.mem_map] at hf
  obtain ⟨⟨i, j⟩, hij, rfl⟩ := hf
  have hbounds := (QSteenrod.mem_strictLowerTriangleIndices_iff N i j).mp hij
  exact ⟨i, j, hbounds.1, hbounds.2.1, hbounds.2.2, rfl,
    P_characteristicCoefficient_isHomogeneous p r N j i hbounds.2.1⟩

/-- Every strict-triangle operation belongs to the Steenrod ideal, stated
directly in terms of its indices. -/
theorem P_c_mem_steenrodIdeal (i j : ℕ) (hj1 : 1 ≤ j) (hjN : j ≤ N)
    (hij : i < j) :
    QSteenrod.P p r i (QSteenrod.c p r N j) ∈ steenrodIdeal p r N := by
  apply mem_steenrodIdeal_of_mem_generators
  apply List.mem_map.mpr
  refine ⟨(i, j), ?_, rfl⟩
  exact (QSteenrod.mem_strictLowerTriangleIndices_iff N i j).mpr ⟨hj1, hjN, hij⟩

universe u

variable {K : Type u} [Field K] [Algebra (GaloisField p r) K]

/-- Vanishing at a matrix of every polynomial in the Steenrod ideal. -/
def steenrodIdealVanishAt (M : Matrix (Fin N) (Fin N) K) : Prop :=
  ∀ f ∈ steenrodIdeal p r N,
    MvPolynomial.aeval (fun ij : Fin N × Fin N => M ij.1 ij.2) f = 0

/-- The zero locus of the generated ideal is exactly the common zero locus
of the fixed generator list. -/
theorem steenrodIdealVanishAt_iff_generators
    (M : Matrix (Fin N) (Fin N) K) :
    steenrodIdealVanishAt p r N M ↔
      powerCharacteristicCoefficientsVanishAt p r M := by
  let ev : QSteenrod.GenericMatrixRing p r N →+* K :=
    (MvPolynomial.aeval fun ij : Fin N × Fin N => M ij.1 ij.2).toRingHom
  constructor
  · intro h f hf
    exact h f (mem_steenrodIdeal_of_mem_generators p r N hf)
  · intro h f hf
    change ev f = 0
    have hle : steenrodIdeal p r N ≤ RingHom.ker ev := by
      rw [steenrodIdeal, Ideal.span_le]
      intro x hx
      change ev x = 0
      exact h x hx
    exact hle hf

end Height.Steenrod
