import Height.Steenrod.PartnerUniversal
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# The universal partner ideal (`defn:partner`)

For a fixed endpoint `N`, package the finite triangular universal equation
list as a homogeneous ideal.  Its pointwise zero locus is exactly the
set-theoretic nilpotent partner variety when `N` is nilpotent and the field
is infinite.
-/

namespace Height.Steenrod

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable (p r n : ℕ) [Fact p.Prime]
variable {K : Type u} [Field K] [Algebra (GaloisField p r) K]

/-- The ideal generated by the universal strict-triangle partner equations
for a fixed endpoint `N`. -/
noncomputable def partnerUniversalIdeal
    (N : Matrix (Fin n) (Fin n) K) :
    Ideal (MvPolynomial (Fin n × Fin n) K) :=
  Ideal.span {f | f ∈ partnerUniversalEquationList p r n N}

theorem mem_partnerUniversalIdeal_of_mem_equations
    (N : Matrix (Fin n) (Fin n) K)
    {f : MvPolynomial (Fin n × Fin n) K}
    (hf : f ∈ partnerUniversalEquationList p r n N) :
    f ∈ partnerUniversalIdeal p r n N :=
  Ideal.subset_span hf

/-- Vanishing at `M` of every polynomial in the universal partner ideal. -/
def partnerUniversalIdealVanishAt
    (N M : Matrix (Fin n) (Fin n) K) : Prop :=
  ∀ f ∈ partnerUniversalIdeal p r n N,
    MvPolynomial.aeval (fun ij : Fin n × Fin n => M ij.1 ij.2) f = 0

/-- The ideal and its finite ordered generating list have the same pointwise
zero locus. -/
theorem partnerUniversalIdealVanishAt_iff_equations
    (N M : Matrix (Fin n) (Fin n) K) :
    partnerUniversalIdealVanishAt p r n N M ↔
      PartnerUniversalEquationsVanishAt p r n N M := by
  let ev : MvPolynomial (Fin n × Fin n) K →+* K :=
    (MvPolynomial.aeval fun ij : Fin n × Fin n => M ij.1 ij.2).toRingHom
  constructor
  · intro h f hf
    exact h f (mem_partnerUniversalIdeal_of_mem_equations p r n N hf)
  · intro h f hf
    change ev f = 0
    have hle : partnerUniversalIdeal p r n N ≤ RingHom.ker ev := by
      rw [partnerUniversalIdeal, Ideal.span_le]
      intro g hg
      change ev g = 0
      exact h g hg
    exact hle hf

/-- Over an infinite field, the universal partner ideal of a nilpotent
endpoint cuts out exactly its nilpotent partners. -/
theorem partnerUniversalIdealVanishAt_iff_partner [Infinite K]
    (N M : Matrix (Fin n) (Fin n) K) (hN : IsNilpotent N) :
    partnerUniversalIdealVanishAt p r n N M ↔
      NilpotentPencil N M := by
  rw [partnerUniversalIdealVanishAt_iff_equations,
    partnerUniversalEquationsVanishAt_iff_partner p r n N M hN]

end Height.Steenrod
