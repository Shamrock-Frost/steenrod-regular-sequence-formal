import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.Algebra.Module.SpanRankOperations
import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.Nakayama
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.RingTheory.KrullDimension.Regular
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Regular local rings: a domain, and quotients by part of a regular system of parameters

## A regular local ring is a domain

Matsumura, *Commutative Ring Theory*, Theorem 14.3, by induction on
`d = dim R = (𝔪).spanFinrank`, avoiding the associated graded ring (mathlib has neither the
Hilbert function of a regular local ring nor "regular ⟹ Cohen–Macaulay").

* `d = 0`: `𝔪` is generated by the empty set, so `𝔪 = 0` and `R` is a field.
* `d = e + 1`: `𝔪 ⊄ 𝔪²` (Nakayama, since `𝔪 ≠ 0`) and `𝔪 ⊄ p` for each of the finitely many
  minimal primes `p` (else `𝔪` is a minimal prime and `dim R = 0`), so prime avoidance
  (`Ideal.subset_union_prime'`) produces `x ∈ 𝔪` outside `𝔪²` and outside every minimal prime
  (`exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes`).  Then `R ⧸ (x)` is again regular
  local, of dimension `e`: its maximal ideal needs at most `e` generators because `x` is part of
  a minimal generating set of `𝔪` (`spanFinrank_map_maximalIdeal_le`, through the cotangent
  space: the line spanned by the image of `x` in `𝔪 ⧸ 𝔪²` has a complement of dimension `e`),
  while Krull's height theorem (`ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank`) keeps
  its dimension at least `e`.  By induction `R ⧸ (x)` is a domain, so `(x)` is prime; it
  contains a minimal prime `p`, and `x ∉ p`, so every `y ∈ p` is `a * x` with `a ∈ p`, i.e.
  `p ≤ 𝔪 • p`, whence `p = 0` by Nakayama.  A minimal prime equal to `0` makes `0` prime, that
  is, `R` a domain.

## Quotients by part of a regular system of parameters

`isRegularLocalRing_quotient_span_of_indepModSq`: if `x₁, …, x_c ∈ 𝔪` are **independent
modulo `𝔪²`** (`IndepModSq`: a combination lying in `𝔪²` has all its coefficients in `𝔪` —
linear independence of their images in the cotangent space, in the form that transports
across quotients), then `R ⧸ (x₁, …, x_c)` is again a regular local ring, of dimension
`dim R − c`.  The induction is the one above, one element at a time: `x₁ ∉ 𝔪²`, and `R` is a
domain, so `x₁` is a nonzerodivisor and `dim (R ⧸ (x₁)) + 1 = dim R`
(`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`); the
maximal ideal of `R ⧸ (x₁)` needs at most `dim R − 1` generators
(`spanFinrank_map_maximalIdeal_le`), so it is regular
(`IsRegularLocalRing.of_spanFinrank_maximalIdeal_le`), and the images of `x₂, …, x_c` are
still independent modulo the square of its maximal ideal.

Mathlib candidates, all of them; `spanFinrank_map_maximalIdeal_le` in particular is the
"an element outside `𝔪²` is part of a minimal generating set" lemma that mathlib lacks.
-/

open IsLocalRing

universe u

namespace Height.Toolbox

/-- **An element outside `𝔪²` is part of a minimal generating set of `𝔪`**, in the form needed
below: if `𝔪` needs `e + 1` generators then its image in `R ⧸ (x)` needs at most `e`.  The proof
splits the cotangent space `𝔪 ⧸ 𝔪²` as the line through the image of `x` (nonzero because
`x ∉ 𝔪²`) plus a complement of dimension `e`, lifts a spanning set of the complement back to
`𝔪`, and uses `IsLocalRing.CotangentSpace.span_image_eq_top_iff` (Nakayama) to see that those
`e + 1` elements generate `𝔪`; modulo `x` only `e` of them are left. -/
theorem spanFinrank_map_maximalIdeal_le {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {x : R} (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2)
    {e : ℕ} (he : (maximalIdeal R).spanFinrank = e + 1) :
    ((maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x}))).spanFinrank ≤ e := by
  have hfin : Module.finrank (ResidueField R) (CotangentSpace R) = e + 1 := by
    rw [← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R, he]
  have hv : (maximalIdeal R).toCotangent ⟨x, hx⟩ ≠ 0 := by
    rw [Ne, Ideal.toCotangent_eq_zero]; exact hx2
  obtain ⟨W, hW⟩ := (Submodule.span (ResidueField R)
    {(maximalIdeal R).toCotangent ⟨x, hx⟩}).exists_isCompl
  have hWfin : Module.finrank (ResidueField R) W = e := by
    have hsum := Submodule.finrank_add_eq_of_isCompl hW
    rw [show Submodule.span (ResidueField R) {(maximalIdeal R).toCotangent ⟨x, hx⟩}
      = (ResidueField R) ∙ (maximalIdeal R).toCotangent ⟨x, hx⟩ from rfl,
      finrank_span_singleton hv, hfin] at hsum
    omega
  have hWrank : W.spanRank = (e : Cardinal) := by
    rw [← Submodule.spanRank_top W, ← Submodule.rank_eq_spanRank_of_free, ← hWfin,
      Module.finrank_eq_rank]
  obtain ⟨T, hTcard, hTspan⟩ := W.exists_span_set_card_eq_spanRank
  rw [hWrank] at hTcard
  have hTfin : T.Finite := by
    rw [← Cardinal.lt_aleph0_iff_set_finite, hTcard]
    exact Cardinal.natCast_lt_aleph0
  have hTncard : T.ncard = e := by
    have hcard : Nat.card ↥T = e := by rw [Nat.card, hTcard, Cardinal.toNat_natCast]
    simpa [Set.ncard_eq_toFinset_card'] using hcard
  have hspanTop : Submodule.span (ResidueField R)
      (insert ((maximalIdeal R).toCotangent ⟨x, hx⟩) T) = ⊤ := by
    rw [Submodule.span_insert, hTspan]
    exact hW.sup_eq_top
  set g := Function.surjInv (Ideal.toCotangent_surjective (maximalIdeal R)) with hg
  have hgeq : ∀ w, (maximalIdeal R).toCotangent (g w) = w :=
    Function.surjInv_eq (Ideal.toCotangent_surjective (maximalIdeal R))
  have himg : (maximalIdeal R).toCotangent '' (insert (⟨x, hx⟩ : ↥(maximalIdeal R)) (g '' T))
      = insert ((maximalIdeal R).toCotangent ⟨x, hx⟩) T := by
    rw [Set.image_insert_eq, ← Set.image_comp]
    congr 1
    ext w
    simp [Function.comp, hgeq]
  have hspanR : Submodule.span R (insert (⟨x, hx⟩ : ↥(maximalIdeal R)) (g '' T)) = ⊤ :=
    IsLocalRing.CotangentSpace.span_image_eq_top_iff.mp (himg ▸ hspanTop)
  have hideal : Ideal.span (Subtype.val '' (insert (⟨x, hx⟩ : ↥(maximalIdeal R)) (g '' T)))
      = maximalIdeal R := by
    have hmap := congrArg (Submodule.map (maximalIdeal R).subtype) hspanR
    rwa [Submodule.map_span, Submodule.map_top, Submodule.range_subtype,
      Ideal.submodule_span_eq] at hmap
  rw [← hideal, Ideal.map_span]
  have himg2 : (Ideal.Quotient.mk (Ideal.span {x})) ''
      (Subtype.val '' (insert (⟨x, hx⟩ : ↥(maximalIdeal R)) (g '' T)))
      = insert 0 ((Ideal.Quotient.mk (Ideal.span {x})) '' (Subtype.val '' (g '' T))) := by
    rw [Set.image_insert_eq, Set.image_insert_eq]
    congr 1
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
  rw [himg2, show Ideal.span (insert (0 : R ⧸ Ideal.span {x})
        ((Ideal.Quotient.mk (Ideal.span {x})) '' (Subtype.val '' (g '' T))))
      = Ideal.span ((Ideal.Quotient.mk (Ideal.span {x})) '' (Subtype.val '' (g '' T))) by
    rw [Ideal.span_insert]; simp]
  refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite
    (((hTfin.image g).image Subtype.val).image _)) ?_
  calc ((Ideal.Quotient.mk (Ideal.span {x})) '' (Subtype.val '' (g '' T))).ncard
      ≤ (Subtype.val '' (g '' T)).ncard := Set.ncard_image_le ((hTfin.image g).image Subtype.val)
    _ ≤ (g '' T).ncard := Set.ncard_image_le (hTfin.image g)
    _ ≤ T.ncard := Set.ncard_image_le hTfin
    _ = e := hTncard

/-- **Prime avoidance** in a Noetherian local ring: if the maximal ideal is contained neither in
`𝔪²` nor in any minimal prime, then some element of `𝔪` avoids all of them at once. -/
theorem exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (hsq : ¬ maximalIdeal R ≤ maximalIdeal R ^ 2)
    (hmin : ∀ p ∈ minimalPrimes R, ¬ maximalIdeal R ≤ p) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ ∀ p ∈ minimalPrimes R, x ∉ p := by
  classical
  have hfin : (minimalPrimes R).Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing R ⊥
  have key := Ideal.subset_union_prime' (ι := Ideal R) (s := hfin.toFinset) (f := id)
    (a := maximalIdeal R ^ 2) (b := maximalIdeal R ^ 2)
    (fun p hp ↦ (hfin.mem_toFinset.mp hp).isPrime) (I := maximalIdeal R)
  simp only [id_eq] at key
  have hnot : ¬((maximalIdeal R : Set R) ⊆ ↑(maximalIdeal R ^ 2) ∪ ↑(maximalIdeal R ^ 2) ∪
      ⋃ p ∈ (hfin.toFinset : Set (Ideal R)), (p : Set R)) := by
    rw [key]
    rintro (h | h | ⟨p, hp, hle⟩)
    · exact hsq h
    · exact hsq h
    · exact hmin p (hfin.mem_toFinset.mp hp) hle
  rw [Set.not_subset] at hnot
  obtain ⟨x, hxm, hxnot⟩ := hnot
  refine ⟨x, hxm, fun hx2 ↦ hxnot ?_, fun p hp hxp ↦ hxnot ?_⟩
  · exact Set.mem_union_left _ (Set.mem_union_left _ hx2)
  · refine Set.mem_union_right _ ?_
    simp only [Set.mem_iUnion, Finset.mem_coe]
    exact ⟨p, hfin.mem_toFinset.mpr hp, hxp⟩

/-- The induction of Matsumura 14.3, on the number of generators of the maximal ideal. -/
theorem isDomain_of_isRegularLocalRing_of_spanFinrank (d : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R],
      (maximalIdeal R).spanFinrank = d → IsDomain R := by
  induction d with
  | zero =>
    intro R _ _ h
    have hbot : maximalIdeal R = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot ((maximalIdeal R).fg_of_isNoetherianRing)).mp h
    let _ := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot).toField
    infer_instance
  | succ e ih =>
    intro R _ _ h
    have hdim : ringKrullDim R = ((e + 1 : ℕ) : WithBot ℕ∞) := by
      rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, h]
    have hsq : ¬ maximalIdeal R ≤ maximalIdeal R ^ 2 := by
      intro hle
      have hb : maximalIdeal R = ⊥ := by
        refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) (maximalIdeal R)
          ((maximalIdeal R).fg_of_isNoetherianRing) ?_ ?_
        · rwa [smul_eq_mul, ← pow_two]
        · exact le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal R) bot_ne_top).symm
      rw [hb] at h
      simp at h
    have hmin : ∀ p ∈ minimalPrimes R, ¬ maximalIdeal R ≤ p := by
      intro p hp hle
      have hpp : p.IsPrime := hp.isPrime
      have hpm : p = maximalIdeal R := le_antisymm (IsLocalRing.le_maximalIdeal hpp.ne_top) hle
      have h0 : (maximalIdeal R).height = 0 := Ideal.height_eq_zero_iff.mpr (hpm ▸ hp)
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h0] at hdim
      norm_cast at hdim
    obtain ⟨x, hxm, hx2, hxp⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes hsq hmin
    have hspanle : Ideal.span ({x} : Set R) ≤ maximalIdeal R := by
      rw [Ideal.span_le, Set.singleton_subset_iff]; exact hxm
    have hne : Ideal.span ({x} : Set R) ≠ ⊤ :=
      ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hspanle
    have hntS : Nontrivial (R ⧸ Ideal.span ({x} : Set R)) := Ideal.Quotient.nontrivial_iff.mpr hne
    have hlocS : IsLocalRing (R ⧸ Ideal.span ({x} : Set R)) :=
      IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
    have hmaxS : (maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x}))
        = maximalIdeal (R ⧸ Ideal.span ({x} : Set R)) :=
      IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
    have hsf : (maximalIdeal (R ⧸ Ideal.span ({x} : Set R))).spanFinrank ≤ e := by
      rw [← hmaxS]; exact spanFinrank_map_maximalIdeal_le hxm hx2 h
    obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.mp
      (Ideal.height_ne_top_of_isPrime (I := maximalIdeal (R ⧸ Ideal.span ({x} : Set R))))
    have hDS : ringKrullDim (R ⧸ Ideal.span ({x} : Set R)) = ((k : ℕ) : WithBot ℕ∞) := by
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← hk]
      norm_cast
    have hek : e ≤ k := by
      have hj : Ideal.span ({x} : Set R) ≤ Ring.jacobson R := by
        rw [← Ideal.jacobson_bot, IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal R) bot_ne_top]
        exact hspanle
      have hkey := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (Ideal.span {x}) hj
      rw [hdim, hDS] at hkey
      have hsp1 : (Ideal.span ({x} : Set R)).spanFinrank ≤ 1 := by
        simpa using Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton x)
      have hle2 : ((e + 1 : ℕ) : WithBot ℕ∞) ≤ ((k + 1 : ℕ) : WithBot ℕ∞) := by
        refine le_trans hkey ?_
        push_cast
        gcongr
        exact_mod_cast hsp1
      have : e + 1 ≤ k + 1 := by exact_mod_cast hle2
      omega
    have hregS : IsRegularLocalRing (R ⧸ Ideal.span ({x} : Set R)) :=
      IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _
        (by rw [hDS]; exact_mod_cast le_trans hsf hek)
    have hsfS : (maximalIdeal (R ⧸ Ideal.span ({x} : Set R))).spanFinrank = e := by
      have hreg := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ Ideal.span ({x} : Set R))
      rw [hDS] at hreg
      have hke : (maximalIdeal (R ⧸ Ideal.span ({x} : Set R))).spanFinrank = k := by
        exact_mod_cast hreg
      omega
    have hdomS : IsDomain (R ⧸ Ideal.span ({x} : Set R)) := ih _ hsfS
    have hprime : (Ideal.span ({x} : Set R)).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime _).mp hdomS
    obtain ⟨p, hpmin, hple⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal R))
      (J := Ideal.span ({x} : Set R)) bot_le
    have hpp : p.IsPrime := hpmin.isPrime
    have hxnp : x ∉ p := hxp p hpmin
    have hpbot : p = ⊥ := by
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) p
        (IsNoetherian.noetherian p) ?_
        (le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal R) bot_ne_top).symm)
      intro y hy
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hple hy)
      have hax : a * x ∈ p := ha ▸ hy
      have hap : a ∈ p := (hpp.mem_or_mem hax).resolve_right hxnp
      rw [← ha, mul_comm a x]
      exact Submodule.smul_mem_smul hxm hap
    have : (⊥ : Ideal R).IsPrime := hpbot ▸ hpp
    exact IsDomain.of_bot_isPrime R

theorem isDomain_of_isRegularLocalRing (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R :=
  isDomain_of_isRegularLocalRing_of_spanFinrank _ R rfl

/-- Equal primes have the same localisation, so regularity transports along an equality of
primes.  (The two `IsPrime` instances are propositions, so the two localisations are the same
type after `subst`.) -/
theorem isRegularLocalRing_atPrime_of_eq {R : Type*} [CommRing R] {P P' : Ideal R}
    [P.IsPrime] [P'.IsPrime] (h : P = P')
    (hreg : IsRegularLocalRing (Localization.AtPrime P)) :
    IsRegularLocalRing (Localization.AtPrime P') := by
  subst h
  exact hreg



/-- `x₁, …, x_c ∈ 𝔪` are **independent modulo `𝔪²`**: any combination lying in `𝔪²` has all
its coefficients in `𝔪`.  This is linear independence of their images in the cotangent
space `𝔪 ⧸ 𝔪²` over the residue field, in the form that transports across quotients. -/
def IndepModSq {R : Type*} [CommRing R] [IsLocalRing R] {c : ℕ} (x : Fin c → R) : Prop :=
  ∀ a : Fin c → R, (∑ j, a j * x j) ∈ maximalIdeal R ^ 2 → ∀ j, a j ∈ maximalIdeal R

/-- An independent family avoids `𝔪²`. -/
theorem IndepModSq.notMem_sq {R : Type*} [CommRing R] [IsLocalRing R] {c : ℕ} {x : Fin c → R}
    (h : IndepModSq x) (j : Fin c) : x j ∉ maximalIdeal R ^ 2 := by
  intro hj
  have h1 : (∑ k, (Pi.single j 1 : Fin c → R) k * x k) = x j := by
    rw [Finset.sum_eq_single j]
    · simp
    · intro b _ hb; simp [hb]
    · intro hb; simp at hb
  have h2 : (Pi.single j 1 : Fin c → R) j ∈ maximalIdeal R :=
    h (Pi.single j 1) (by rw [h1]; exact hj) j
  rw [Pi.single_eq_same] at h2
  exact (maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ h2 isUnit_one)

/-- The maximal ideal of a quotient of a local ring is the image of the maximal ideal. -/
theorem map_maximalIdeal_quotient {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    (hI : I ≤ maximalIdeal R) [IsLocalRing (R ⧸ I)] :
    (maximalIdeal R).map (Ideal.Quotient.mk I) = maximalIdeal (R ⧸ I) := by
  refine IsLocalRing.eq_maximalIdeal ?_
  have hcm : Ideal.comap (Ideal.Quotient.mk I) ((maximalIdeal R).map (Ideal.Quotient.mk I))
      = maximalIdeal R := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact sup_eq_left.mpr hI
  have hne : (maximalIdeal R).map (Ideal.Quotient.mk I) ≠ ⊤ := fun htop =>
    (maximalIdeal.isMaximal R).ne_top (by rw [← hcm, htop, Ideal.comap_top])
  exact (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    (maximalIdeal.isMaximal R)).resolve_left hne

/-- **Quotient of a regular local ring by part of a regular system of parameters.**  If
`x₁, …, x_c` lie in `𝔪` and are independent modulo `𝔪²`, then `R ⧸ (x₁, …, x_c)` is again a
regular local ring, of dimension `dim R − c`.

Induction on `c`.  `x₁ ∉ 𝔪²`, and `R` is a domain (`isDomain_of_isRegularLocalRing`), so `x₁`
is a nonzerodivisor and `dim (R ⧸ (x₁)) + 1 = dim R`
(`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`); its
maximal ideal needs at most `dim R − 1` generators (`spanFinrank_map_maximalIdeal_le`), so it
is regular (`IsRegularLocalRing.of_spanFinrank_maximalIdeal_le`), and the images of
`x₂, …, x_c` are still independent modulo the square of its maximal ideal. -/
theorem isRegularLocalRing_quotient_span_of_indepModSq (c : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (x : Fin c → R),
      (∀ j, x j ∈ maximalIdeal R) → IndepModSq x →
        IsRegularLocalRing (R ⧸ Ideal.span (Set.range x)) ∧
          ringKrullDim (R ⧸ Ideal.span (Set.range x)) + (c : WithBot ℕ∞) = ringKrullDim R := by
  induction c with
  | zero =>
      intro R _ _ x _ _
      have hbot : Ideal.span (Set.range x) = ⊥ := by
        rw [show Set.range x = (∅ : Set R) from Set.range_eq_empty x, Ideal.span_empty]
      have he : (R ⧸ Ideal.span (Set.range x)) ≃+* R :=
        (Ideal.quotEquivOfEq hbot).trans (RingEquiv.quotientBot R)
      exact ⟨IsRegularLocalRing.of_ringEquiv he.symm, by
        rw [ringKrullDim_eq_of_ringEquiv he]; simp⟩
  | succ c ih =>
      intro R _ hR x hx hindep
      classical
      -- `x 0` is a nonzerodivisor outside `𝔪²`
      have hdom : IsDomain R := isDomain_of_isRegularLocalRing R
      have hx0m : x 0 ∈ maximalIdeal R := hx 0
      have hx0sq : x 0 ∉ maximalIdeal R ^ 2 := hindep.notMem_sq 0
      have hx0ne : x 0 ≠ 0 := fun h => hx0sq (h ▸ Submodule.zero_mem _)
      have hx0reg : x 0 ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hx0ne
      -- the quotient by `x 0`
      have hspan0 : Ideal.span {x 0} ≤ maximalIdeal R :=
        (Ideal.span_singleton_le_iff_mem _).mpr hx0m
      have hne0 : Ideal.span {x 0} ≠ ⊤ := fun h =>
        (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ hspan0))
      have _ : Nontrivial (R ⧸ Ideal.span {x 0}) := Ideal.Quotient.nontrivial_iff.mpr hne0
      have _ : IsLocalRing (R ⧸ Ideal.span {x 0}) :=
        IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
      have hdim0 : ringKrullDim (R ⧸ Ideal.span {x 0}) + 1 = ringKrullDim R :=
        ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
          hx0reg hx0m
      have hmax0 : (maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x 0}))
          = maximalIdeal (R ⧸ Ideal.span {x 0}) := map_maximalIdeal_quotient _ hspan0
      -- the number of generators drops
      have hbot0 : ringKrullDim (R ⧸ Ideal.span {x 0}) ≠ ⊥ := by
        rw [Ne, ringKrullDim_eq_bot_iff_subsingleton]
        exact not_subsingleton _
      obtain ⟨m, hm⟩ := WithBot.ne_bot_iff_exists.mp hbot0
      obtain ⟨e, he⟩ : ∃ e : ℕ, (maximalIdeal R).spanFinrank = e + 1 := by
        rcases Nat.eq_zero_or_pos (maximalIdeal R).spanFinrank with h | h
        · exfalso
          have h0 : ringKrullDim R = 0 := by rw [← hR.spanFinrank_maximalIdeal, h]; simp
          rw [h0, ← hm] at hdim0
          have h1 : m + 1 = 0 := by exact_mod_cast hdim0
          simp at h1
        · exact ⟨(maximalIdeal R).spanFinrank - 1, by omega⟩
      have hsf : (maximalIdeal (R ⧸ Ideal.span {x 0})).spanFinrank ≤ e := by
        rw [← hmax0]
        exact spanFinrank_map_maximalIdeal_le hx0m hx0sq he
      have hdimR : ringKrullDim R = ((e + 1 : ℕ) : WithBot ℕ∞) := by
        rw [← hR.spanFinrank_maximalIdeal, he]
      have hdimR0 : ringKrullDim (R ⧸ Ideal.span {x 0}) = ((e : ℕ) : WithBot ℕ∞) := by
        rw [hdimR, ← hm] at hdim0
        have h1 : m + 1 = ((e : ℕ∞) + 1) := by exact_mod_cast hdim0
        have h2 : m = (e : ℕ∞) := le_antisymm ((ENat.add_le_add_iff_right (by simp)).mp h1.le)
          ((ENat.add_le_add_iff_right (by simp)).mp h1.ge)
        rw [← hm, h2]
        norm_cast
      have hregR0 : IsRegularLocalRing (R ⧸ Ideal.span {x 0}) :=
        IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ (by rw [hdimR0]; exact_mod_cast hsf)
      -- the tail stays independent
      set y : Fin c → (R ⧸ Ideal.span {x 0}) :=
        fun j => Ideal.Quotient.mk _ (x j.succ) with hy
      have hym : ∀ j, y j ∈ maximalIdeal (R ⧸ Ideal.span {x 0}) := by
        intro j
        rw [← hmax0]
        exact Ideal.mem_map_of_mem _ (hx j.succ)
      have hyindep : IndepModSq y := by
        intro a' ha' j
        choose a ha using fun j => Ideal.Quotient.mk_surjective (I := Ideal.span {x 0}) (a' j)
        have hsum : Ideal.Quotient.mk (Ideal.span {x 0}) (∑ j, a j * x j.succ)
            = ∑ j, a' j * y j := by
          rw [map_sum]
          exact Finset.sum_congr rfl fun j _ => by rw [map_mul, ha j, hy]
        have hmem : (∑ j, a j * x j.succ) ∈
            Ideal.comap (Ideal.Quotient.mk (Ideal.span {x 0}))
              ((maximalIdeal R ^ 2).map (Ideal.Quotient.mk (Ideal.span {x 0}))) := by
          rw [Ideal.mem_comap, hsum, Ideal.map_pow, hmax0]
          exact ha'
        rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at hmem
        obtain ⟨m, hm, z, hz, hzsum⟩ := Submodule.mem_sup.mp hmem
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
        have hcomb : (∑ k, (Fin.cases (-r) a k : R) * x k) ∈ maximalIdeal R ^ 2 := by
          rw [Fin.sum_univ_succ]
          simp only [Fin.cases_zero, Fin.cases_succ]
          have : -r * x 0 + ∑ k, a k * x k.succ = m := by
            rw [← hzsum]; ring
          rw [this]
          exact hm
        have := hindep (Fin.cases (-r) a) hcomb j.succ
        rw [Fin.cases_succ] at this
        rw [← ha j, ← hmax0]
        exact Ideal.mem_map_of_mem _ this
      obtain ⟨hreg1, hdim1⟩ := ih (R ⧸ Ideal.span {x 0}) y hym hyindep
      -- assemble
      have hle : Ideal.span {x 0} ≤ Ideal.span (Set.range x) :=
        (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.subset_span ⟨0, rfl⟩)
      have hmapx : (Ideal.span (Set.range x)).map (Ideal.Quotient.mk (Ideal.span {x 0}))
          = Ideal.span (Set.range y) := by
        rw [Ideal.map_span, ← Set.range_comp]
        have hins : Set.range (fun j : Fin (c + 1) => Ideal.Quotient.mk (Ideal.span {x 0}) (x j))
            = insert 0 (Set.range y) := by
          ext w
          constructor
          · rintro ⟨j, rfl⟩
            refine Fin.cases ?_ (fun k => Or.inr ⟨k, rfl⟩) j
            · exact Or.inl (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _))
          · rintro (rfl | ⟨k, rfl⟩)
            · exact ⟨0, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)⟩
            · exact ⟨k.succ, rfl⟩
        rw [Function.comp_def, hins, Ideal.span_insert]
        simp
      have hequiv : ((R ⧸ Ideal.span {x 0}) ⧸ Ideal.span (Set.range y))
          ≃+* (R ⧸ Ideal.span (Set.range x)) := by
        rw [← hmapx]
        exact DoubleQuot.quotQuotEquivQuotOfLE hle
      refine ⟨IsRegularLocalRing.of_ringEquiv hequiv, ?_⟩
      rw [← ringKrullDim_eq_of_ringEquiv hequiv]
      have : ((c : ℕ) : WithBot ℕ∞) + 1 = ((c + 1 : ℕ) : WithBot ℕ∞) := by push_cast; ring
      rw [← this, ← add_assoc, hdim1, hdim0]

end Height.Toolbox
